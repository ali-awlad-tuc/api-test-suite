					"name": "TC-P01 | GET all posts – Status 200 [Positive]",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// TC-P01: GET /posts",
									"// Expected: Status 200, response is a non-empty list",
									"",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is a non-empty array', function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.be.an('array');",
									"    pm.expect(data.length).to.be.greaterThan(0);",
									"});",
									"",
									"pm.test('Response time is below 2000ms', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"pm.test('Content-Type is application/json', function () {",
									"    pm.response.to.have.header('Content-Type');",
									"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/posts",
							"host": ["{{base_url}}"],
							"path": ["posts"]
						},
						"description": "Retrieve all posts. Expected: 200 OK, array of 100 posts."
					}
				},

